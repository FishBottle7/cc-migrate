{
  "name": "@cc-migrate/desktop-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "cc-migrate 独立跨平台 App（Electron 主进程直连 core + Vue 3 渲染进程）",
  "main": "dist/index.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "pnpm run build:main && pnpm run build:renderer",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && vue-tsc --noEmit -p tsconfig.renderer.json",
    "test": "pnpm run typecheck",
    "dev": "node scripts/dev.mjs",
    "start": "pnpm run build && electron .",
    "gen:icon": "node scripts/gen-icon.mjs --verify",
    "dist": "pnpm run build && node scripts/set-dist-dir.mjs",
    "dist:win": "pnpm run build && node scripts/set-dist-dir.mjs --win",
    "dist:win:dir": "pnpm run build && node scripts/set-dist-dir.mjs --win dir",
    "dist:win:check": "pnpm run dist:win && node scripts/dist-check.mjs",
    "smoke:packaged": "node scripts/smoke-packaged.mjs"
  },
  "dependencies": {
    "@cc-migrate/core": "workspace:*",
    "@cc-migrate/ui": "workspace:*",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
  }
}
