{
  "name": "@session-migrate/desktop-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "session-migrate 独立跨平台 App（Electron 主进程直连 core + Vue 3 渲染进程）",
  "main": "dist/index.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "pnpm run build:main && pnpm run build:renderer",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && vue-tsc --noEmit -p tsconfig.renderer.json",
    "test": "pnpm run typecheck",
    "dev": "node scripts/dev.mjs",
    "start": "pnpm run build && electron ."
  },
  "dependencies": {
    "@session-migrate/core": "workspace:*",
    "@session-migrate/ui": "workspace:*",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "electron": "^37.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
  }
}
